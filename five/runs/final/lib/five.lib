library (five) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;

  type ("an") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }
  type ("result") {
    base_type : array;
    data_type : bit;
    bit_width : 32;
    bit_from : 31;
    bit_to : 0;
  }
  type ("seg_out") {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }

  cell ("five") {
    area : 784.503 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0000;
    }
    pin("control") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("reset") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VPWR") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VGND") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("an") {
      bus_type : an;
      direction : output;
      capacitance : 0.0000;
    pin("an[3]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("an[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("an[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("an[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
    bus("result") {
      bus_type : result;
      direction : output;
      capacitance : 0.0000;
    pin("result[31]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[30]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[29]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[28]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[27]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[26]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[25]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[24]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[23]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[22]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[21]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[20]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[19]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[18]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[17]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[16]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[15]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[14]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[13]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[12]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[11]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[10]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[9]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[8]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[7]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[6]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[5]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[4]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[3]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("result[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
    bus("seg_out") {
      bus_type : seg_out;
      direction : output;
      capacitance : 0.0000;
    pin("seg_out[6]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("seg_out[5]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("seg_out[4]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("seg_out[3]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("seg_out[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("seg_out[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("seg_out[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
  }

}
