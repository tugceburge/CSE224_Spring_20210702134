      capacitance : 0.0232;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.40061");
	}
	cell_fall(scalar) {
          values("0.65461");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.40061");
	}
	cell_fall(scalar) {
          values("0.36390");
	}
      }
    }
    pin("rst") {
      direction : input;
