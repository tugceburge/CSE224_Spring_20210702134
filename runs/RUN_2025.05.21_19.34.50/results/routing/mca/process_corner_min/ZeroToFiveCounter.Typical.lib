    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }

  cell ("ZeroToFiveCounter") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0232;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.40061");
	}
	cell_fall(scalar) {
          values("0.65461");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.40061");
	}
	cell_fall(scalar) {
          values("0.36390");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.38904");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("0.03878");
	}
      }
    }
